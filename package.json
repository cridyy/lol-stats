{
  "name": "lol-stats",
  "private": true,
  "version": "0.8.0",
  "description": "国服英雄联盟战绩统计工具",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "node ./scripts/dev-full.mjs",
    "check:frontend": "vue-tsc --noEmit",
    "check:backend": "cargo check --manifest-path .\\src-tauri\\Cargo.toml",
    "test:scoring": "node ./scripts/verify-scoring.mjs",
    "test:backend": "cargo test --manifest-path .\\src-tauri\\Cargo.toml",
    "build": "vue-tsc --noEmit && vite build",
    "verify": "node ./scripts/verify.mjs",
    "verify:watch": "node ./scripts/verify.mjs --watch",
    "preview": "vite preview",
    "tauri": "tauri",
    "release:publish": "pwsh -NoLogo -NoProfile -File ./scripts/publish-release.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "darkreader": "^4.9.128",
    "html-to-image": "^1.11.13",
    "lucide-vue-next": "^0.577.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
